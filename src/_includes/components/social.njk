{#- Per-mark viewBox. The wordmark is cropped to its ink (measured with
    getBBox: x0 y7.71 w24 h8.57) because a 24x24 box around a 2.8:1 mark makes
    preserveAspectRatio scale to the HEIGHT, so widening the element only adds
    blank space. Cropped, the width drives the scale and the mark actually fills. -#}
{%- set boxes = {
  "rednote": "0 7.71 24 8.57",
  "wechat": "0 0 24 24",
  "x": "0 0 24 24"
} -%}
{%- set row = [
  ["rednote", s.social_rednote],
  ["wechat", s.social_wechat],
  ["x", "X"]
] -%}
{%- if site.links.rednote or site.links.wechat or site.links.x
        or site.qr.rednote or site.qr.wechat or site.qr.x %}
<p class="foot__social">
  {%- for k, label in row %}
  {%- set href = site.links[k] %}
  {%- set qr = site.qr[k] %}
  {%- if href or qr %}
  <span class="foot__s">
    {#- A channel reachable only by QR is not a link. Rendering it as a button
        keeps it focusable and tappable, so the panel opens on a phone too --
        :focus-within fires on tap where :hover never does. -#}
    {%- if href %}
    <a href="{{ href }}" data-mark="{{ k }}" class="{{ 'is-word' if k == 'rednote' and lang == 'en' }}" rel="noopener" target="_blank" aria-label="{{ label }}" title="{{ label }}">
    {%- else %}
    <button type="button" data-mark="{{ k }}" class="{{ 'is-word' if k == 'rednote' and lang == 'en' }}" aria-label="{{ label }}" title="{{ label }}">
    {%- endif %}
      {%- if k == 'rednote' and lang == 'en' %}<span class="foot__word">rednote</span>
      {%- else %}<svg viewBox="{{ boxes[k] }}" aria-hidden="true" focusable="false"><path d="{{ marks[k] }}"/></svg>{% endif %}
    {%- if href %}</a>{% else %}</button>{% endif %}
    {%- if qr %}
    <span class="foot__qr">
      <img src="{{ qr }}" width="160" height="160" alt="{{ label }}" loading="lazy" decoding="async">
      <em>{{ s.social_scan }}</em>
    </span>
    {%- endif %}
  </span>
  {%- endif %}
  {%- endfor %}
</p>
{%- endif %}
