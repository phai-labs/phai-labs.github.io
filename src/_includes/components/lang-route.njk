{#- Language routing for readers from outside China. Included at the top of
    <head> in both layouts, so it runs before anything paints.

    On a Chinese page, a reader whose browser asks for no Chinese at all is
    sent to the English copy of the same page, keeping query and hash. It
    never fights a choice: clicking a language switch records it, and a
    recorded choice always wins -- including for someone on an English browser
    who picked Chinese. Arriving from another page of this site counts as a
    choice too, for browsers where storage is blocked.

    Crawlers and link previewers are left alone. Googlebot browses as en-US,
    and without this exception it would be bounced off every Chinese page and
    stop indexing them; hreflang already tells search engines about both. -#}
<script>
(function () {
  var KEY = 'phai-lang';
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('[data-lang-switch]');
    if (a) { try { localStorage.setItem(KEY, a.getAttribute('data-lang-switch')); } catch (err) {} }
  });
{%- if lang == 'zh' %}
  var pref = null;
  try { pref = localStorage.getItem(KEY); } catch (err) {}
  if (pref === 'zh') return;
  if (pref !== 'en') {
    if (/bot|crawl|spider|slurp|preview|headless|lighthouse|google|facebookexternalhit/i.test(navigator.userAgent)) return;
    var ls = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
    for (var i = 0; i < ls.length; i++) { if (/^zh\b/i.test(ls[i])) return; }
    if (document.referrer.indexOf(location.origin + '/') === 0) return;
  }
  location.replace({{ (page.url | switchUrl(lang)) | dump | safe }} + location.search + location.hash);
{%- endif %}
})();
</script>
