{#- Language switch. Included at the top of <head> in both layouts.

    English is the default tree at "/" and every visit lands on the page that
    was asked for; Chinese lives under "/zh/". No language choice is
    remembered and nothing is inferred from the browser's language, so a
    reader sees English unless they click the switch. hreflang tells search
    engines about both trees. -#}
<script>
(function () {
  document.addEventListener('click', function (e) {
    var a = e.target && e.target.closest && e.target.closest('[data-lang-switch]');
    if (!a) return;
    // both trees come from the same templates, so a section id exists on both sides
    if (location.hash) a.setAttribute('href', a.getAttribute('href').split('#')[0] + location.hash);
  });
})();
</script>
