{#- A link that knows the release calendar. Expects `rl` = {label, key?, href?}.
    key "sciencebuddy" -> that project's product url, live only on its day;
    key "scienceide_page" etc. -> site.links[key], shown once it has an href AND the
    project's day has come; plain href -> a normal link. A key that is not in
    site.links (e.g. "sciencebuddy_product") keeps its href and is still gated
    on its prefix's release. Site-relative links take →, off-site ones ↗.
    rl.soon (a label such as "Coming soon") holds the row as a pending pill
    whatever its href, for something announced but not open yet. -#}
{%- set base = (rl.key.split('_')[0]) if rl.key else '' -%}
{%- set r = site.releases[base] if base and site.releases[base] else null -%}
{%- set fromData = true -%}
{%- if rl.key and site.links[rl.key] is defined %}{% set href = site.links[rl.key] %}
{%- elif r and rl.key == base %}{% set href = r.url %}
{%- else %}{% set href = rl.href %}{% set fromData = false %}{% endif -%}
{#- A page on this site named in site.json opens in the reader's language
    (callers localize their own rl.href); files such as PDFs have no language. -#}
{%- if fromData and href and href[0] == '/' and href[1] != '/' -%}
{%- set hp = href.split('#')[0].split('?')[0] -%}
{%- if not hp.startsWith('/assets/') and not ('.' in (hp.split('/') | last)) %}{% set href = href | localeUrl(lang) %}{% endif -%}
{%- endif -%}
{%- set gated = r and not r.live -%}
{%- if rl.soon %}<span class="link link--pending"><span>{{ rl.label }}</span><small>{{ rl.soon }}</small></span>
{%- elif href and not gated %}<a class="link link--live" href="{{ href }}">{{ rl.label }} {{ '→' if href[0] == '/' else '↗' }}</a>
{%- elif r %}<span class="link link--pending"><span>{{ rl.label }}</span><small>{{ r.date | releaseLabel(lang) }}</small></span>
{%- else %}<span class="link link--pending"><span>{{ rl.label }}</span><small>{{ s.pending }}</small></span>{% endif -%}
