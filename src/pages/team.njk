---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ '/team/' | localeUrl(lang) }}index.html"
layout: layouts/base.njk
pageKey: team
eleventyComputed:
  title: "{{ i18n[lang].nav | navLabel('team') }}"
  description: "{{ team.spine[lang].lede if team.spine else i18n[lang].site_tagline }}"
---
{%- set sp = team.spine[lang] -%}

<section class="hero hero--page" id="top">
  <div class="shell">
    <p class="eyebrow">{{ sp.eyebrow }}</p>
    <h1 class="display">{{ sp.title }}</h1>
    <p class="lede">{{ sp.lede }}</p>
  </div>
</section>

{#- The visual spine the requirements ask to keep: scientific definition ->
    model training -> real execution -> continuous improvement. Drawn as a line
    of four nodes; the stroke extends on reveal. -#}
<section class="sec sec--spine" data-field="still" aria-label="{{ sp.spine_label }}">
  <div class="shell">
    <ol class="spine" style="--amber-x:50%" data-reveal>
      {%- for node in sp.nodes %}
      <li class="spine__node{% if loop.index == 3 %} spine__node--amber{% endif %}">
        <i class="spine__dot" aria-hidden="true"></i>
        <span class="num">0{{ loop.index }}</span>
        <h2>{{ node[0] }}</h2>
        <p>{{ node[1] }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="sec sec--people" data-field="still">
  <div class="shell">
    <p class="eyebrow">{{ sp.founders_label }}</p>
    <ul class="people" data-reveal style="--amber-x:66.4%">
      {%- for m in team.members | sort(false, false, 'order') %}
      {%- set p = m[lang] -%}
      <li class="person" id="{{ m.id }}" style="--k:{{ loop.index0 }}">
        <div class="person__portrait{% if not m.photo %} person__portrait--empty{% endif %}" aria-hidden="{{ 'true' if not m.photo else 'false' }}">
          {%- if m.photo %}<img src="{{ m.photo }}" width="240" height="240" loading="lazy" alt="{{ p.name }}">{% endif %}
        </div>
        <div class="person__body">
          <h2 class="person__name">{{ p.name }}{% if lang == 'zh' %}<span class="person__latin">{{ p.name_latin }}</span>{% endif %}</h2>
          <p class="person__title">{{ p.title }}</p>
          <p class="person__aff">{{ p.affiliation }}</p>
          <p class="person__bio">{{ p.bio }}</p>
          <ul class="tags">{% for r in p.research %}<li>{{ r }}</li>{% endfor %}</ul>
          <p class="person__links">
            {%- if m.links.homepage %}<a href="{{ m.links.homepage }}">{{ '个人主页' if lang == 'zh' else 'Homepage' }} ↗</a>{% endif %}
            {%- if m.links.scholar %}<a href="{{ m.links.scholar }}">Google Scholar ↗</a>{% endif %}
            {%- if m.links.orcid %}<a href="{{ m.links.orcid }}">ORCID ↗</a>{% endif %}
            {%- if m.links.linkedin %}<a href="{{ m.links.linkedin }}">LinkedIn ↗</a>{% endif %}
            {%- if m.links.x %}<a href="{{ m.links.x }}">X ↗</a>{% endif %}
          </p>
        </div>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="sec sec--join">
  <div class="shell split">
    <h2 class="display-2">{{ sp.join_title }}</h2>
    <div>
      <p class="lede">{{ sp.join_body }}</p>
      <p class="actions"><a class="btn" href="{{ '/careers/' | localeUrl(lang) }}">{{ i18n[lang].nav | navLabel('careers') }} →</a></p>
    </div>
  </div>
</section>
