---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/papers/' | localeUrl(lang) }}index.html"
eleventyExcludeFromCollections: true
---
{%- set s = i18n[lang] -%}
{%- set dest = '/tech/' | localeUrl(lang) -%}
{%- set to = dest + '#papers' -%}
{#- The archive now closes /tech/, so /papers/ forwards there, to the papers
    section rather than the top of the page. Same static-host redirect as
    paper-vanity.njk: an instant meta refresh, which Google reads as permanent,
    plus rel=canonical naming the page (without the fragment, which is not part
    of a URL a crawler indexes). Excluded from collections so sitemap.xml lists
    only /tech/. The record pages at /papers/<slug>/ are untouched.

    no-referrer: /tech/'s language routing (components/lang-route.njk) treats
    arriving from this site as a choice already made. A hop through this stub
    is not a choice, so it must not leave this site's URL as the referrer --
    otherwise an English-language reader following an old /papers/ link would
    stay on the Chinese page instead of being sent to /en/tech/#papers. -#}
<!DOCTYPE html>
<html lang="{{ s.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>{{ s.pub_headline }} — {{ s.site_name }}</title>
<link rel="canonical" href="{{ site.url }}{{ dest }}">
<meta http-equiv="refresh" content="0; url={{ to }}">
<style>
  html{color-scheme:dark}
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0a0a0b;
       color:rgba(240,238,232,.68);font:400 15px/1.7 system-ui,-apple-system,'Segoe UI',sans-serif;
       padding:1.5rem;text-align:center}
  a{color:#9ba7ff}
</style>
</head>
<body>
<p>{{ s.pub_headline }} → <a href="{{ to }}">{{ s.nav | navLabel('tech') }}</a></p>
<script>location.replace("{{ to }}");</script>
</body>
</html>
