---
pagination:
  data: paperVanityPages
  size: 1
  alias: vp
permalink: "{{ ('/' + vp.paper.vanity + '/') | localeUrl(vp.lang) }}index.html"
eleventyExcludeFromCollections: true
---
{%- set p = vp.paper -%}
{%- set lang = vp.lang -%}
{%- set s = i18n[lang] -%}
{%- set to = ('/papers/' + p.slug + '/') | localeUrl(lang) -%}
{#- A short link for print and slides: /dfm/ -> /papers/dfm/.
    GitHub Pages serves static files only, so there is no real 301 to be had.
    An instant meta refresh is what Google documents as the static-host stand-in
    and reads as a permanent redirect; rel=canonical names the destination for
    anything that does not follow it. Deliberately NOT noindex -- that would tell
    a crawler to drop the page before it acts on the redirect. Excluded from
    collections so it never reaches sitemap.xml, which lists canonical URLs only.
    location.replace rather than assign, so Back returns to where the reader came
    from instead of bouncing them forward again. -#}
<!DOCTYPE html>
<html lang="{{ s.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ p.title }} — {{ s.site_name }}</title>
<link rel="canonical" href="{{ site.url }}{{ to }}">
<meta http-equiv="refresh" content="0; url={{ to }}">
<style>
  html{color-scheme:dark}
  body{margin:0;min-height:100vh;display:grid;place-items:center;background:#0a0a0b;
       color:rgba(240,238,232,.68);font:400 15px/1.7 system-ui,-apple-system,'Segoe UI',sans-serif;
       padding:1.5rem;text-align:center}
  a{color:#9ba7ff}
</style>
</head>
<body>
<p>{{ '正在前往' if lang == 'zh' else 'Redirecting to' }} <a href="{{ to }}">{{ site.url }}{{ to }}</a></p>
<script>location.replace("{{ to }}");</script>
</body>
</html>
