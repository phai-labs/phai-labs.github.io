---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "{{ '/about/' | localeUrl(lang) }}index.html"
layout: layouts/base.njk
pageKey: about
eleventyComputed:
  title: "{{ copy.about[lang].hero.title | plain | safe }}"
  description: "{{ copy.about[lang].hero.lede | safe }}"
---
{%- set t = copy.about[lang] -%}
{%- set s = i18n[lang] -%}

<section class="hero hero--page hero--about" id="top">
  <div class="shell">
    <p class="eyebrow">{{ t.hero.eyebrow | brand | safe }}</p>
    <h1 class="display">{{ t.hero.title }}</h1>
    <p class="lede">{{ t.hero.lede }}</p>
  </div>
</section>

{%- for sct in t.sections %}
<section class="sec sec--chapter" data-field="calm" id="about-{{ loop.index }}">
  <div class="shell split split--chapter">
    <div class="chapter__head">
      <p class="eyebrow"><span class="num">0{{ loop.index }}</span></p>
      <h2 class="display-2">{{ sct.title }}</h2>
    </div>
    <div class="prose prose--lg">{% for p in sct.body %}<p>{{ p }}</p>{% endfor %}</div>
  </div>
</section>
{%- endfor %}

{#- The timeline renders only when there is data for it. It is off right now;
    refilling copy/about.json milestones brings the whole section back with
    no template change. -#}
{%- if t.milestones and t.milestones.length %}
<section class="sec sec--milestones" data-field="grid" id="milestones">
  <div class="shell">
    <p class="eyebrow"><span class="num">0{{ t.sections.length + 1 }}</span>{{ '发展节点' if lang == 'zh' else 'Milestones' }}</p>
    <ol class="milestones">
      {%- for m in t.milestones %}
      <li>
        <time datetime="{{ m.date }}">{{ m.date | replace('-', '.') }}</time>
        <h3>{{ m.title }}</h3>
        <p>{{ m.body }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>
{%- endif %}

<section class="sec sec--join">
  <div class="shell split">
    <h2 class="display-2">{{ '加入我们' if lang == 'zh' else 'Join us' }}</h2>
    <p class="actions">
      <a class="btn" href="{{ '/careers/' | localeUrl(lang) }}">{{ s.nav | navLabel('careers') }} →</a>
    </p>
  </div>
</section>

{#- Where the core team comes from, moved here from the old team page. A logo
    wall without logos: an institution's mark is its trademark, so until real
    files are supplied the name itself is the mark -- which also claims less
    than a crest does. Each entry takes an optional `logo` path and switches to
    the image the moment one exists. -#}
{%- if team.partners %}
<section class="sec sec--unis" data-field="still">
  <div class="shell">
    <p class="eyebrow">{{ team.partners[lang].eyebrow }}</p>
    <ul class="unis" data-reveal>
      {%- for u in team.partners.list %}
      <li class="uni" style="--k:{{ loop.index0 }}">
        {%- if u.logo %}<img class="uni__mark uni__mark--{{ u.kind or 'seal' }}{% if u.halo %} uni__mark--halo{% endif %}" src="{{ u.logo }}" alt="{{ u[lang] }}" loading="lazy">{% endif %}
        <span class="uni__name">{{ u[lang] }}</span>
      </li>
      {%- endfor %}
    </ul>
  </div>
</section>
{%- endif %}
